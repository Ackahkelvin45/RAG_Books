# Copy to .env and adjust. Never commit .env.

# Postgres superuser (migrations, tests' admin fixture). Local only.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shepherd

# Restricted application role (no superuser). Book visibility is enforced in the app's SQL, not by RLS.
APP_DB_PASSWORD=shepherd_app
APP_DATABASE_URL=postgresql://shepherd_app:shepherd_app@localhost:5433/shepherd

# MinIO (local S3)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=shepherd-books

# DeepSeek API (phase 4): https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Hugging Face downloads: the xet transfer protocol stalls on some networks; plain HTTP is reliable.
HF_HUB_DISABLE_XET=1


# Admin portal (api/): password for /admin, and a random secret for the session cookie
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Google sign-in (optional). Create an OAuth client (Web application) in Google Cloud Console;
# authorised redirect URI: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8010


# Sign-up codes are emailed with Resend (resend.com). Unset = codes printed to the API log (dev only).
# MAIL_FROM must use a domain verified in Resend; onboarding@resend.dev works only to your own address.
RESEND_API_KEY=
MAIL_FROM=First Love Church <no-reply@example.org>
