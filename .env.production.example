# Production settings. Copy to .env on the server and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- the address people use --------------------------------------------------------
DOMAIN=guide.example.org
PUBLIC_URL=https://guide.example.org

# --- database and storage (internal only; pick strong passwords) --------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MINIO_ROOT_USER=shepherd
MINIO_ROOT_PASSWORD=
S3_BUCKET=shepherd-books

# --- AI ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# --- admin portal (/admin) and the session cookie --------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# --- email (sign-up codes) via Resend; MAIL_FROM must be on a domain verified in Resend ---
RESEND_API_KEY=
MAIL_FROM=First Love Church <no-reply@guide.example.org>

# --- Google sign-in (optional; leave empty to hide the button) ----------------------------
# Authorised redirect URI in Google Cloud Console: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- search tuning (leave as is) ----------------------------------------------------
SHEPHERD_QUESTION_SEARCH=off
SHEPHERD_MERGE_NEIGHBOURS=on
# The reranker is the slow step (~0.3 s per candidate on a CPU core set). Fewer candidates = faster answers;
# 20 is the quality default, 12 is a reasonable speed setting. Models run on the CPU on a server (SHEPHERD_DEVICE=cpu).
SHEPHERD_RERANK_POOL=20
