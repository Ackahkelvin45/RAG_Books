# Production settings. Copy to .env on the server and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- the address people use --------------------------------------------------------
DOMAIN=guide.example.org          # used by Caddy; ignore if you run your own nginx
PUBLIC_URL=https://guide.example.org

# --- database and storage (internal only; pick strong passwords) --------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MINIO_ROOT_USER=shepherd
MINIO_ROOT_PASSWORD=
S3_BUCKET=shepherd-books

# --- AI ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# --- admin portal (/admin) and the session cookie --------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# --- email (sign-up codes) via Resend; MAIL_FROM must be on a domain verified in Resend ---
RESEND_API_KEY=
MAIL_FROM=First Love Church <no-reply@guide.example.org>
# A book that fails to process is reported to this address (empty = only in the worker log).
SHEPHERD_ALERT_EMAIL=

# --- Google sign-in (optional; leave empty to hide the button) ----------------------------
# Authorised redirect URI in Google Cloud Console: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- models (decided 2026-10-14 from the retrieval eval; English only) ----------------------
# bge-base-en-v1.5 scored within one point of bge-m3 (passage hit@8 65.3 vs 66.0) at a fifth of the memory
# and about a third of the query time; bge-m3 (2.2 GB) was being evicted on the 3.8 GB server. The three
# SHEPHERD_EMBED_* values must change together; the worker backfills the column when idle.
SHEPHERD_EMBED_MODEL=BAAI/bge-base-en-v1.5
SHEPHERD_EMBED_DIM=768
SHEPHERD_EMBED_COLUMN=embedding_base
SHEPHERD_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
SHEPHERD_DEVICE=cpu

# --- search tuning (leave as is) ----------------------------------------------------
SHEPHERD_QUESTION_SEARCH=off
SHEPHERD_MERGE_NEIGHBOURS=on
# The reranker is the slow step (~0.2 s per candidate with MiniLM-L6 on the server). Fewer candidates = faster
# answers; 20 is the quality default, 12 is a reasonable speed setting.
SHEPHERD_RERANK_POOL=20
# One search at a time on a one-core box (a second question waits and is told so); questions per person per day.
SHEPHERD_MAX_CONCURRENT_SEARCHES=1
SHEPHERD_DAILY_QUESTIONS=100
